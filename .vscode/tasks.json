{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "AirWSJT-X: Desktop Sidecar Build",
			"type": "process",
			"command": "node",
			"args": ["scripts/build-desktop-sidecar.js"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "AirWSJT-X: Build Android APK",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"tauri",
				"--",
				"android",
				"build",
				"--apk"
			],
			"isBackground": false,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "AirWSJT-X: Desktop Build",
			"dependsOn": ["AirWSJT-X: Desktop Sidecar Build"],
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"tauri",
				"--",
				"build",
				"--no-bundle",
				"--config",
				"src-tauri/tauri.desktop.conf.json"
			],
			"windows": {
				"args": [
					"run", "tauri", "--", "build", "--no-bundle",
					"--config", "src-tauri\\tauri.desktop.conf.json",
					"--config", "src-tauri\\tauri.windows-desktop.conf.json"
				]
			},
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "AirWSJT-X: Desktop Run",
			"type": "shell",
			"command": "${workspaceFolder}/src-tauri/target/release/airwsjtx",
			"windows": {
				"command": "${workspaceFolder}\\src-tauri\\target\\release\\airwsjtx.exe"
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "AirWSJT-X: Desktop Build and Run",
			"dependsOrder": "sequence",
			"dependsOn": [
				"AirWSJT-X: Desktop Build",
				"AirWSJT-X: Desktop Run"
			],
			"problemMatcher": []
		},
		{
			"label": "AirWSJT-X: Desktop Dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"tauri",
				"--",
				"dev",
				"--config",
				"src-tauri/tauri.desktop.conf.json"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}