{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "AirWSJT-X",
  "version": "0.3.4",
  "identifier": "us.ad7np.airwsjt-x",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AirWSJT-X",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "externalBin": [
      "binaries/airwsjtx_bridge"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements-mas.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}