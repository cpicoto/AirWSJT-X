{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "AirWSJT-X",
  "version": "0.2.4",
  "identifier": "com.airwsjtx.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:safe"
  },
  "app": {
    "windows": [
      {
        "title": "AirWSJT-X",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "providerShortName": "QJ2R7N9BRA",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
