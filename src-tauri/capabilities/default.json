{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/capability.json",
  "identifier": "default",
  "description": "Default capability for AirWSJT-X",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "airwsjtx_bridge", "sidecar": true },
        { "name": "py", "cmd": "py" },
        { "name": "python", "cmd": "python" },
        {
          "name": "python-local",
          "cmd": "C:\\Users\\cpico\\AppData\\Local\\Programs\\Python\\Python312\\python.exe"
        }
      ]
    }
  ]
}
